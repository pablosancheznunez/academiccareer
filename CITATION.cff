type: software
title: "academiccareer: Descriptive, Evidence-Based Profiles of Academic Careers"
version: 0.1.0
date-released: 2026-11-02
authors:
  - family-names: "Sánchez-Núñez"
    given-names: "Pablo"
    orcid: "https://orcid.org/0000-0001-7845-9506"
